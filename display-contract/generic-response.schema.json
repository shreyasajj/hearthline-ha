{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "response_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "layout": {
      "enum": [
        "compact",
        "reading",
        "search",
        "steps",
        "comparison"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "spoken_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "blocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "paragraph"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "bullets"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "minItems": 1,
                "maxItems": 8
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "type",
              "items"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "steps"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                "minItems": 1,
                "maxItems": 10
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "type",
              "items"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "sources"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "^https://"
                    },
                    "excerpt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "title",
                    "url"
                  ]
                },
                "minItems": 1,
                "maxItems": 5
              }
            },
            "required": [
              "type",
              "items"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "table"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "minItems": 1,
                "maxItems": 4
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "minItems": 1,
                  "maxItems": 4
                },
                "minItems": 1,
                "maxItems": 8
              }
            },
            "required": [
              "type",
              "columns",
              "rows"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "status"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "state": {
                "enum": [
                  "success",
                  "partial",
                  "pending",
                  "error"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "type",
              "label",
              "state"
            ]
          }
        ]
      },
      "minItems": 1,
      "maxItems": 8
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 15,
      "maximum": 300
    }
  },
  "required": [
    "protocol_version",
    "response_id",
    "layout",
    "title",
    "summary",
    "spoken_text",
    "blocks",
    "ttl_seconds"
  ],
  "title": "Pixel Home 0.3 display response",
  "description": "Additionally enforce 32768 UTF-8 bytes, nonblank strings, HTTPS host/no credentials, and matching table row widths. No followups."
}
